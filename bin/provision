#!/bin/bash
MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PATH="${PATH}:${MYDIR}"
cd "${MYDIR}/.."
[ -f .env ]&&source .env

vagrant up \
	--no-parallel \
	--no-provision

virsh -c qemu:///system list --all
REAL_VM_NAME=$(virsh -c qemu:///system list --all --name | grep "debian" | head -n 1)
if [ -n "$REAL_VM_NAME" ]; then
  echo "Trovata VM Libvirt: $REAL_VM_NAME"
  virsh -c qemu:///system dumpxml "$REAL_VM_NAME"
  sudo cat /var/log/libvirt/qemu/${REAL_VM_NAME}.log
else
  echo "Nessuna VM libvirt trovata con quel nome."
fi

vagrant rsync
vagrant provision
